{
  "appId": "io.github.fystcore.paperwing",
  "appName": "Paper Wing",
  "webDir": "www",
  "backgroundColor": "#000000",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "fystcore.github.io"
    ]
  },
  "android": {
    "backgroundColor": "#000000",
    "allowMixedContent": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable",
      "initialViewportFitValueHint": "cover"
    }
  }
}
